<Project Sdk="Microsoft.NET.Sdk" InitialTargets="GoiCheckGame">

  <!--
    Two builds from the same Plugin.cs:

      dotnet build -c Release                      IL2CPP build (Linux, BepInEx 6)         -> bin/Release/net6.0/GoiBridge.dll
      dotnet build -c Release -p:Backend=Mono      Mono build   (Windows/macOS, BepInEx 5) -> bin/Release/net472/GoiBridge.dll

    Point GameDir at your "Getting Over It" folder if the default for your OS is wrong:
      dotnet build -c Release -p:Backend=Mono "-p:GameDir=D:/Games/Getting Over It"
    On macOS (or if the Managed folder is somewhere unusual) also/instead pass -p:ManagedDir=...
  -->

  <PropertyGroup>
    <Backend Condition="'$(Backend)' == ''">Il2Cpp</Backend>
    <AssemblyName>GoiBridge</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Default game folder per OS (a Steam install in the default library). -->
  <PropertyGroup Condition="'$(GameDir)' == ''">
    <GameDir Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildProgramFiles32)/Steam/steamapps/common/Getting Over It</GameDir>
    <GameDir Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam/steamapps/common/Getting Over It</GameDir>
    <GameDir Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(HOME)/snap/steam/common/.local/share/Steam/steamapps/common/Getting Over It</GameDir>
  </PropertyGroup>

  <!-- ========================= IL2CPP (Linux) ========================= -->
  <PropertyGroup Condition="'$(Backend)' == 'Il2Cpp'">
    <TargetFramework>net6.0</TargetFramework>
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(Backend)' == 'Il2Cpp'">
    <!-- BepInEx 6 IL2CPP + Harmony -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <!-- Interop assemblies are generated by BepInEx on the FIRST run of the game. -->
    <Reference Include="$(GameDir)/BepInEx/interop/*.dll" Private="false" />
  </ItemGroup>

  <!-- =========================== Mono (Windows / macOS) =========================== -->
  <PropertyGroup Condition="'$(Backend)' == 'Mono'">
    <TargetFramework>net472</TargetFramework>
    <ManagedDir Condition="'$(ManagedDir)' == '' And Exists('$(GameDir)/GettingOverIt_Data/Managed')">$(GameDir)/GettingOverIt_Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)/Getting Over It.app/Contents/Resources/Data/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(Backend)' == 'Mono'">
    <!-- BepInEx 5 (+ HarmonyX). Reference assemblies let net472 build on Linux/macOS too. -->
    <PackageReference Include="BepInEx.Core" Version="5.*" IncludeAssets="compile" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- The real Assembly-CSharp may have private members; the IL2CPP interop assembly makes everything public.
         The publicizer makes the Mono one behave the same at compile time. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.*" PrivateAssets="all" />

    <Reference Include="$(ManagedDir)/UnityEngine*.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)/Assembly-CSharp.dll" Private="false" Publicize="true" />
  </ItemGroup>

  <!-- Friendly errors instead of a wall of CS0246s when the game folder is wrong. -->
  <Target Name="GoiCheckGame">
    <Error Condition="'$(Backend)' != 'Il2Cpp' And '$(Backend)' != 'Mono'"
           Text="Backend must be 'Il2Cpp' or 'Mono' (got '$(Backend)')." />
    <Error Condition="'$(Backend)' == 'Il2Cpp' And !Exists('$(GameDir)/BepInEx/interop')"
           Text="IL2CPP build: '$(GameDir)/BepInEx/interop' not found. Run the game once with BepInEx installed, or pass -p:GameDir=..." />
    <Error Condition="'$(Backend)' == 'Mono' And !Exists('$(ManagedDir)/Assembly-CSharp.dll')"
           Text="Mono build: Assembly-CSharp.dll not found in '$(ManagedDir)'. Pass -p:GameDir=... or -p:ManagedDir=..." />
  </Target>
</Project>